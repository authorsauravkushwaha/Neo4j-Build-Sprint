{
  "name": "graphmentor-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GraphMentor AI - The Engineering Career Navigator. React + Vite PWA + Capacitor Android, backed by Neo4j graph data and Supabase.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:only": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --pretty false",
    "lint:secrets": "node scripts/scan-secrets.mjs",
    "lint:secrets:history": "node scripts/scan-secret-history.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "emit:cypher": "tsx scripts/emit-cypher.ts",
    "emit:social-card": "tsx scripts/emit-social-card.ts",
    "verify:resources": "tsx scripts/verify-resources.ts",
    "seed:neo4j": "tsx scripts/seed-neo4j.ts",
    "validate:seed": "tsx scripts/validate-seed.ts",
    "verify:rls": "tsx scripts/verify-rls.ts",
    "smoke:http": "tsx scripts/smoke-http.ts",
    "appwrite:provision": "tsx scripts/appwrite-schema.ts",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "cap:add:android": "cap add android",
    "verify:browser": "tsx scripts/verify-browser.ts",
    "verify": "node scripts/verify-all.mjs",
    "oracle:export": "tsx scripts/export-frontier-fixture.ts",
    "oracle": "node scripts/run-oracle.mjs",
    "audience:measure": "tsx scripts/audience/measure.ts",
    "audience": "npm run audience:measure && npm run audience:simulate",
    "audience:simulate": "node --import tsx scripts/audience/report.ts",
    "verify:injection": "tsx scripts/verify-injection.ts",
    "workflow": "tsx scripts/workflow.ts",
    "audit:self": "tsx scripts/audit/self.ts",
    "import:public-apis": "tsx scripts/import-public-apis.ts",
    "db:provision": "sh db/bin/provision.sh",
    "db:up": "sh db/bin/start.sh start",
    "db:down": "sh db/bin/start.sh stop",
    "db:status": "sh db/bin/start.sh status",
    "db:sql": "sh db/bin/sql.sh",
    "db:backup": "sh db/bin/backup.sh",
    "db:restore-verify": "sh db/bin/restore-verify.sh",
    "db:env": "sh db/bin/app-env.sh",
    "verify:db": "tsx scripts/verify-db.ts",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "server": "tsx server/server.ts",
    "check:bundle": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.9",
    "@capacitor/network": "7.0.4",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.6",
    "@supabase/supabase-js": "2.117.3",
    "cytoscape": "3.34.3",
    "lucide-react": "1.55.0",
    "motion": "^12.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "three": "0.186.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/cytoscape": "3.21.9",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.14.0",
    "jsdom": "^26.1.0",
    "pg": "8.23.1",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.11",
    "workbox-window": "7.4.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
