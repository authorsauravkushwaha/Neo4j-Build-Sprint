// ============================================================================
// GraphMentor AI — Neo4j schema for user-owned data
//
// Hand-maintained (NOT generated by emit:cypher). The curriculum schema lives in
// neo4j/schema.cypher. Apply both with `npm run seed:neo4j` (it runs this file
// after schema.cypher), or run this file in Neo4j Browser / cypher-shell.
//
// Idempotent: every statement uses IF NOT EXISTS, so re-running is safe.
// Requires Neo4j 5.x (AuraDB Free qualifies). Only uniqueness constraints and
// range indexes are used.
//
// Design and property reference: docs/neo4j-schema.md
// The application, not the database, enforces account scoping: every query
// takes $userId as a parameter (see supabase/functions/_shared/platform/neo4jStore.ts).
// ============================================================================

// ---- Accounts (profile preferences live on the node) -----------------------
CREATE CONSTRAINT gm_appuser_id IF NOT EXISTS FOR (n:AppUser) REQUIRE n.id IS UNIQUE;

// ---- Saved roadmaps ---------------------------------------------------------
CREATE CONSTRAINT gm_roadmap_id IF NOT EXISTS FOR (n:Roadmap) REQUIRE n.id IS UNIQUE;
CREATE INDEX gm_roadmap_user IF NOT EXISTS FOR (n:Roadmap) ON (n.userId);
CREATE INDEX gm_roadmap_updated IF NOT EXISTS FOR (n:Roadmap) ON (n.updatedAt);

CREATE CONSTRAINT gm_roadmaptask_id IF NOT EXISTS FOR (n:RoadmapTask) REQUIRE n.id IS UNIQUE;
// key = roadmapId|orderIndex|skillId. One task per position in a roadmap, so re-saving updates in place.
CREATE CONSTRAINT gm_roadmaptask_key IF NOT EXISTS FOR (n:RoadmapTask) REQUIRE n.key IS UNIQUE;
CREATE INDEX gm_roadmaptask_roadmap IF NOT EXISTS FOR (n:RoadmapTask) ON (n.roadmapId);
CREATE INDEX gm_roadmaptask_user IF NOT EXISTS FOR (n:RoadmapTask) ON (n.userId);

// ---- Skill progress ---------------------------------------------------------
CREATE CONSTRAINT gm_skillrating_id IF NOT EXISTS FOR (n:SkillRating) REQUIRE n.id IS UNIQUE;
// key = userId|skillId. One rating per user per skill.
CREATE CONSTRAINT gm_skillrating_key IF NOT EXISTS FOR (n:SkillRating) REQUIRE n.key IS UNIQUE;
CREATE INDEX gm_skillrating_user IF NOT EXISTS FOR (n:SkillRating) ON (n.userId);

// ---- Bookmarks --------------------------------------------------------------
CREATE CONSTRAINT gm_bookmark_id IF NOT EXISTS FOR (n:Bookmark) REQUIRE n.id IS UNIQUE;
// key = userId|targetId. One bookmark per user per target.
CREATE CONSTRAINT gm_bookmark_key IF NOT EXISTS FOR (n:Bookmark) REQUIRE n.key IS UNIQUE;
CREATE INDEX gm_bookmark_user IF NOT EXISTS FOR (n:Bookmark) ON (n.userId);

// ---- Feedback (userId is null for anonymous submissions) --------------------
CREATE CONSTRAINT gm_feedback_id IF NOT EXISTS FOR (n:Feedback) REQUIRE n.id IS UNIQUE;
CREATE INDEX gm_feedback_user IF NOT EXISTS FOR (n:Feedback) ON (n.userId);

// ---- Rate limiting (one node per key and fixed window) ----------------------
CREATE CONSTRAINT gm_ratelimitbucket_id IF NOT EXISTS FOR (n:RateLimitBucket) REQUIRE n.id IS UNIQUE;
CREATE INDEX gm_ratelimitbucket_expiry IF NOT EXISTS FOR (n:RateLimitBucket) ON (n.expiresAt);

// ---- Nonce replay ledger ----------------------------------------------------
CREATE CONSTRAINT gm_usednonce_nonce IF NOT EXISTS FOR (n:UsedNonce) REQUIRE n.nonce IS UNIQUE;
CREATE INDEX gm_usednonce_expiry IF NOT EXISTS FOR (n:UsedNonce) ON (n.expiresAt);
