{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["supabase/functions/_shared/core/*"],
      "npm:@supabase/supabase-js@2.117.3": ["node_modules/@supabase/supabase-js"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.functions.tsbuildinfo"
  },
  "include": ["supabase/functions", "scripts/types/deno-globals.d.ts"]
}


