# ============================================================================
# GraphMentor AI — FRONTEND build-time variables (safe to expose in the browser)
# Copy to `.env.local` and fill in. Everything VITE_* ends up in the JS bundle,
# so nothing secret belongs here. Database passwords and AI keys live ONLY in
# Supabase Edge Function secrets (see supabase/.env.example).
# ============================================================================

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" / publishable key. Safe in the browser ONLY because every
# table is protected by Row Level Security. Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=

# Base URL of the deployed Edge Functions.
# Leave empty to auto-derive "${VITE_SUPABASE_URL}/functions/v1".
VITE_API_BASE_URL=

# Public site URL, used to write the canonical <link> and the Open Graph/
# sitemap URLs in index.html. Example: https://graphmentor.example.com
# Leave empty and the canonical tag is simply omitted (better than emitting a
# wrong canonical URL that tells search engines to index a page that is not this
# one).
VITE_SITE_URL=

# Base path. Use "/" for a root domain or "/your-repo-name/" for GitHub Pages
# project sites (a wrong value is a blank page with /assets/... 404s in the console).
# Leave "/" for a normal domain; the GitHub Pages workflow derives the right value
# from the repository name and ignores this file entirely.
VITE_BASE_PATH=/

# Extra hosts allowed by the Content-Security-Policy connect-src directive,
# space separated, e.g. "https://api.example.com". Leave empty normally.
VITE_CSP_EXTRA_CONNECT_SRC=

# Optional: Sentry/analytics-style endpoint. Leave empty; the app ships with no
# third-party telemetry enabled and this value is not required to run.
VITE_TELEMETRY_ENDPOINT=

# Shown in Settings > About so users can report the exact build they run.
VITE_APP_VERSION=1.0.0

# Demo mode: when "true", the app starts in the clearly-labelled local sample
# dataset instead of calling the backend.
VITE_FORCE_DEMO_MODE=false

# ---------------------------------------------------------------------------
# LOCAL TOOLING (ignored by the built site)
# ---------------------------------------------------------------------------
# Extra hostnames the *dev* and *preview* servers will answer to, comma
# separated. Vite already allows localhost and *.e2b.app / *.trycloudflare.com
# tunnels; add your own here if you reach the dev server through a proxy or a
# container hostname. Example: DEV_ALLOWED_HOSTS=my-box.local,192.168.1.20
# Without an entry, the server answers 403 "Blocked request. This host is not
# allowed" — that is Vite's DNS-rebinding protection, not a bug.
DEV_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# The project's own database (db/) — server-side verification only.
# These are NOT read by the web app and must never be VITE_* variables.
# Print the real values (passwords stay in the 0600 pgpass file, never in a URL)
# with:  eval "$(npm run --silent db:env)"
# DATABASE_URL is the least-privileged gm_app role; DATABASE_ADMIN_URL is the
# gm_admin role used by verify:rls and by smoke:http's test-only table checks.
# DATABASE_URL=
# DATABASE_ADMIN_URL=



# ---------------------------------------------------------------------------
# BUILT-IN WEBSITE DATABASE — server-side only, NEVER prefix these with VITE_.
# npm run dev / npm run preview / npm start automatically start the website,
# the /api auth + graph backend, and (when enabled) a disk-backed account
# database. No Supabase values above are needed for built-in password accounts.
# See docs/database.md for deployment, data scope, backups and limitations.
# ---------------------------------------------------------------------------
# PORT=3000
# Optional full PostgreSQL alternative for ACCOUNTS (default: disk-backed PGlite).
# DATABASE_AUTH_URL=
# Default: .localdata/postgres. On a host, point this at a PERSISTENT disk.
# GM_DATABASE_DIR=/var/data/postgres

# ---------------------------------------------------------------------------
# NEO4J — one supported live graph backend (server-side credentials only).
#
# The Node backend (npm start / server/website.ts) opens a real Neo4j connection
# with the OFFICIAL neo4j-javascript-driver over Bolt (neo4j+s:// for AuraDB).
# All graph reads execute parameterised Cypher against this instance.
#
# Set these three values to enable LIVE NEO4J mode. When they are absent the
# backend starts anyway but /api/health/neo4j reports 503 and the UI falls
# back to the clearly-labelled bundled DEMO DATA.
# ---------------------------------------------------------------------------
# Bolt URI — copy from Neo4j Aura console (looks like the line below).
NEO4J_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_WITH_YOUR_AURA_PASSWORD
# Default database on Aura is "neo4j".
NEO4J_DATABASE=neo4j
# Optional: milliseconds per query (clamped server-side 1–30 s).
NEO4J_TIMEOUT_MS=8000
# Optional: hard row cap per query (clamped 10–2000).
NEO4J_MAX_ROWS=400
#
# Legacy / Deno-only HTTPS Query API URL (kept for Supabase Edge Functions).
# The Node backend does NOT use this for Bolt; it only uses it as a fallback
# to synthesise a neo4j+s:// URI when NEO4J_URI is unset.
# NEO4J_QUERY_URL=https://YOUR_INSTANCE_ID.databases.neo4j.io/db/neo4j/query/v2

# ---------------------------------------------------------------------------
# OPTIONAL Postgres graph fallback.
#
# When Neo4j credentials are unset AND one of these is configured, the server
# uses the PostgreSQL-backed graph alternative (reported as postgres-live,
# never neo4j-live). Configure NEO4J_URI above when the intended source is Neo4j.
# ---------------------------------------------------------------------------
# GM_GRAPH_DATABASE_DIR=/var/data/graph-postgres
# GRAPH_DATABASE_URL=

# ---- Server tuning ----
# Comma-separated list of origins allowed to call the API cross-origin.
# Include the GitHub Pages URL so the Pages-hosted frontend can reach this backend.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://authorsauravkushwaha.github.io
# When running npm run server separately, let Vite proxy instead of opening a DB:
# GM_EXTERNAL_API=true
# AUTH_PORT=8787
# Local plain-HTTP development ONLY. Keep false/unset on public HTTPS sites.
AUTH_ALLOW_INSECURE_HTTP=false
# Only behind a trusted proxy that sanitizes forwarded headers:
AUTH_TRUST_PROXY=false
