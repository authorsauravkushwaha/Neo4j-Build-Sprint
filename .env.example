# ============================================================================
# GraphMentor AI — FRONTEND build-time variables (safe to expose in the browser)
# Copy to `.env.local` and fill in. Everything VITE_* ends up in the JS bundle,
# so nothing secret belongs here. Database passwords and AI keys live ONLY in
# Supabase Edge Function secrets (see supabase/.env.example).
# ============================================================================

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" / publishable key. Safe in the browser ONLY because every
# table is protected by Row Level Security. Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=

# Base URL of the deployed Edge Functions.
# Leave empty to auto-derive "${VITE_SUPABASE_URL}/functions/v1".
VITE_API_BASE_URL=

# Public site URL, used to write the canonical <link> and the Open Graph/
# sitemap URLs in index.html. Example: https://graphmentor.example.com
# Leave empty and the canonical tag is simply omitted (better than emitting a
# wrong canonical URL that tells search engines to index a page that is not this
# one).
VITE_SITE_URL=

# Base path. Use "/" for a root domain or "/your-repo-name/" for GitHub Pages
# project sites (a wrong value is a blank page with /assets/... 404s in the console).
# Leave "/" for a normal domain; the GitHub Pages workflow derives the right value
# from the repository name and ignores this file entirely.
VITE_BASE_PATH=/

# Extra hosts allowed by the Content-Security-Policy connect-src directive,
# space separated, e.g. "https://api.example.com". Leave empty normally.
VITE_CSP_EXTRA_CONNECT_SRC=

# Optional: Sentry/analytics-style endpoint. Leave empty; the app ships with no
# third-party telemetry enabled and this value is not required to run.
VITE_TELEMETRY_ENDPOINT=

# Shown in Settings > About so users can report the exact build they run.
VITE_APP_VERSION=1.0.0

# Demo mode: when "true", the app starts in the clearly-labelled local sample
# dataset instead of calling the backend.
VITE_FORCE_DEMO_MODE=false

# ---------------------------------------------------------------------------
# LOCAL TOOLING (ignored by the built site)
# ---------------------------------------------------------------------------
# Extra hostnames the *dev* and *preview* servers will answer to, comma
# separated. Vite already allows localhost and *.e2b.app / *.trycloudflare.com
# tunnels; add your own here if you reach the dev server through a proxy or a
# container hostname. Example: DEV_ALLOWED_HOSTS=my-box.local,192.168.1.20
# Without an entry, the server answers 403 "Blocked request. This host is not
# allowed" — that is Vite's DNS-rebinding protection, not a bug.
DEV_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# The project's own database (db/) — server-side verification only.
# These are NOT read by the web app and must never be VITE_* variables.
# Print the real values (passwords stay in the 0600 pgpass file, never in a URL)
# with:  eval "$(npm run --silent db:env)"
# DATABASE_URL is the least-privileged gm_app role; DATABASE_ADMIN_URL is the
# gm_admin role used by verify:rls and by smoke:http's test-only table checks.
# DATABASE_URL=
# DATABASE_ADMIN_URL=


