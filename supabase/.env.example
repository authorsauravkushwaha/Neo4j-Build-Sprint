# ============================================================================
# GraphMentor AI — SUPABASE EDGE FUNCTION SECRETS (server-side only)
#
#   supabase secrets set --env-file supabase/.env
#
# Every value here stays on the server. Nothing in this file is exposed to the
# browser or the Android bundle, and no filled-in copy of it may be committed.
#
# The app runs with NONE of these set: it reports the truth through
# /health-check and the frontend falls back to the clearly-labelled local sample
# dataset. Fill them in when you want live data, accounts and AI answers.
# ============================================================================

# ---- Neo4j AuraDB (Free) ---------------------------------------------------
# HTTPS Query API endpoint: Neo4j Aura console -> your instance -> Connect ->
# Query API. The URL already contains your instance id and database name.
NEO4J_QUERY_URL=https://YOUR_INSTANCE_ID.databases.neo4j.io/db/neo4j/query/v2
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_WITH_YOUR_AURA_PASSWORD
# Milliseconds per query. Keep it small so a slow graph never holds a request open.
NEO4J_TIMEOUT_MS=8000
# Hard cap on rows returned per query (windowing guard against huge payloads).
NEO4J_MAX_ROWS=400

# ---- Supabase project ------------------------------------------------------
# SUPABASE_URL and SUPABASE_ANON_KEY are injected by the platform at runtime;
# they are listed here for documentation only. Override them only if you know
# why you need to.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server-only. Used by Edge Functions for privileged tasks (rate-limit buckets,
# nonce claiming, scheduled cleanup) and for nothing else. NEVER expose this.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider adapter (all optional; the app works with none of it) -----
# One of: none | gemini | openai-compatible
# With AI_PROVIDER=none the mentor endpoint still answers, using the
# deterministic rules engine over the same graph context.
AI_PROVIDER=none
#
# Gemini (free tier available): https://aistudio.google.com/ -> API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
#
# Any OpenAI-compatible endpoint (Groq, OpenRouter, a local llama.cpp server...).
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
#
# Guard rails. Clamped in code: timeout 2–60 s, output tokens 64–4096,
# context 2000–40000 characters.
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_CONTEXT_CHARS=12000

# ---- Security controls -----------------------------------------------------
# Comma-separated browser origins allowed by CORS. Exactly these origins (plus
# wildcard subdomains such as your-project.netlify.app) are echoed back; the
# functions never answer with a bare "*".
# Android/Capacitor apps send either https://localhost or capacitor://localhost.
ALLOWED_ORIGINS=https://YOUR_USERNAME.github.io,https://localhost,capacitor://localhost,http://localhost:5173,http://localhost:4173
#
# Reject a signed request whose timestamp is older/newer than this (ms).
REQUEST_MAX_SKEW_MS=120000
#
# Replay protection. When REQUIRE_REQUEST_SIGNING=true, expensive endpoints
# (mentor-chat, generate-learning-roadmap, save-roadmap) additionally require an
# HMAC signature plus a single-use nonce. Leave false until the client that
# signs requests is deployed, otherwise those endpoints will refuse traffic.
# Generate the secret with: openssl rand -hex 32
REQUEST_SIGNING_SECRET=
REQUIRE_REQUEST_SIGNING=false
#
# Rate limits (fixed windows, counted in Postgres so they survive isolates).
# Chat also has a fixed 30-per-hour ceiling that is not configurable.
RATE_LIMIT_CHAT_PER_MINUTE=6
RATE_LIMIT_ANALYSIS_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=90
RATE_LIMIT_WRITE_PER_MINUTE=30
#
# Sign-in attempt ceilings, enforced by POST /auth-guard before the browser
# reaches Supabase Auth. Per address (the address arrives hashed, so the counter
# never sees it) and per host. Raise the per-minute figure only if real users
# report being blocked after a typo; the hourly ceiling is what stops a slow
# trickle of guesses.
AUTH_ATTEMPTS_PER_MINUTE=10
AUTH_ATTEMPTS_PER_HOUR=40
AUTH_ATTEMPTS_PER_IP_PER_MINUTE=30
#
# Largest JSON body accepted (bytes). Clamped to 4 KiB – 128 KiB.
MAX_JSON_BODY_BYTES=32768

# ---- Operations ------------------------------------------------------------
# error | warn | info | debug. Logs never contain secrets, prompts or user text.
LOG_LEVEL=info
# Free-form label shown in health-check ("production", "staging", "local").
ENVIRONMENT=production

# ============================================================================
# LOCAL SEEDING ONLY (used by `npm run seed:neo4j`, not by the Edge Functions).
# The Query API sends the password in a Basic auth header, so http:// is refused
# unless you set this to true knowingly (for example against a local Neo4j with
# a self-signed certificate). Never set it for a hosted instance.
# ============================================================================
NEO4J_ALLOW_HTTP=false


